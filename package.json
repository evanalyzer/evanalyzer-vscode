{
  "name": "evanalyzer-file-support",
  "displayName": "EVAnalyzer File Support",
  "description": "Syntax highlighting, JSON Schema validation/autocomplete, and schema-driven creation wizards for EVAnalyzer .evapipe, .evaproj, and .evapt files.",
  "version": "0.2.0",
  "publisher": "evanalyzer",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/evanalyzer/evanalyzer-vscode.git"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "json",
        "extensions": [
          ".evapipe",
          ".evaproj",
          ".evapt"
        ]
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "*.evapipe",
        "url": "./schemas/pipeline_template.schema.json"
      },
      {
        "fileMatch": "*.evaproj",
        "url": "./schemas/project.schema.json"
      },
      {
        "fileMatch": "*.evapt",
        "url": "./schemas/project_template.schema.json"
      }
    ],
    "commands": [
      {
        "command": "evanalyzer.newProject",
        "title": "New EVAnalyzer Project...",
        "category": "EVAnalyzer"
      },
      {
        "command": "evanalyzer.newProjectTemplate",
        "title": "New EVAnalyzer Project Template...",
        "category": "EVAnalyzer"
      },
      {
        "command": "evanalyzer.newPipelineTemplate",
        "title": "New EVAnalyzer Pipeline Template...",
        "category": "EVAnalyzer"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "evanalyzer.newFileSubmenu",
          "group": "navigation@1"
        }
      ],
      "evanalyzer.newFileSubmenu": [
        {
          "command": "evanalyzer.newProject",
          "group": "1_evanalyzer@1"
        },
        {
          "command": "evanalyzer.newProjectTemplate",
          "group": "1_evanalyzer@2"
        },
        {
          "command": "evanalyzer.newPipelineTemplate",
          "group": "1_evanalyzer@3"
        }
      ]
    },
    "submenus": [
      {
        "id": "evanalyzer.newFileSubmenu",
        "label": "New EVAnalyzer File"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "check-types": "tsc --noEmit",
    "vscode:prepublish": "npm run check-types && node esbuild.js --production",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.29.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
